DATA_ROOT=./data/blobs
DATABASE_URL=sqlite:///./data/app.db   # Postgres: postgresql+psycopg://asr:asr@localhost:5432/asr
STORAGE_BACKEND=local
INFERENCE_SAMPLE_RATE=16000
MAX_UPLOAD_BYTES=524288000
WORKER_THREADS=4

# --- Part E: queue + recovery ---
QUEUE_BACKEND=inprocess          # set to "celery" to use Redis + Celery workers
REDIS_URL=redis://localhost:6379/0
TASK_SOFT_TIME_LIMIT_S=600       # task fails cleanly after this
TASK_HARD_MARGIN_S=60            # hard kill = soft + margin
VISIBILITY_TIMEOUT_S=3600        # must exceed soft+margin
RECOVERY_INTERVAL_S=120          # background sweep period (0 = off)
STUCK_AFTER_S=900                # must exceed soft+margin
QUEUED_AFTER_S=900               # keep above your worst-case healthy queue wait
MAX_ATTEMPTS=3

# --- Part H: inference hardware and scoring ---
# Defaults written into every run's config.model_options (so they are part of the config hash).
DEVICE=cpu                       # cpu | cuda
COMPUTE_TYPE=int8                # cpu: int8 | int8_float32 | float32 ; cuda: float16 | int8_float16 | bfloat16 | ...
VAD_DEVICE=cpu                   # keep cpu on every machine (identical chunk boundaries)
NORMALIZER=whisper-en-v1         # text normalization for new scores: whisper-en-v1 | basic-v1
# KEY=...                        # your own API key for curl, from python -m scripts.rotate_keys (never commit)
