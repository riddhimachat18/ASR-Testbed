# GPU machine settings. Copy to .env.gpu (git-ignored) and select it with ASR_ENV_FILE=.env.gpu
#   PowerShell: $env:ASR_ENV_FILE=".env.gpu"     bash: export ASR_ENV_FILE=.env.gpu
DATA_ROOT=./data/blobs
DATABASE_URL=postgresql+psycopg://asr:asr@localhost:5432/asr
STORAGE_BACKEND=local
QUEUE_BACKEND=celery
REDIS_URL=redis://localhost:6379/0
RECOVERY_INTERVAL_S=120
STUCK_AFTER_S=900
QUEUED_AFTER_S=900

DEVICE=cuda
COMPUTE_TYPE=float16
VAD_DEVICE=cpu
NORMALIZER=whisper-en-v1
